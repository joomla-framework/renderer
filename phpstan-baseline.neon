parameters:
	ignoreErrors:
		-
			message: "#^Class Illuminate\\\\View\\\\Compilers\\\\BladeCompiler constructor invoked with 1 parameter, 2 required\\.$#"
			count: 1
			path: src/BladeRenderer.php

		-
			message: "#^PHPDoc tag @param for parameter \\$template with type string\\|Symfony\\\\Component\\\\Templating\\\\TemplateReferenceInterface is not subtype of native type string\\.$#"
			count: 1
			path: src/PhpEngineRenderer.php

		-
			message: "#^Class Twig\\\\Loader\\\\ExistsLoaderInterface not found\\.$#"
			count: 1
			path: src/TwigRenderer.php
